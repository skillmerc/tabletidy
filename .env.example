# Copy to web/.env.local (gitignored) and fill from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise (Fraud Defense) web site key registered in App Check
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev only: App Check debug token registered in Firebase console (App Check > Apps > Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
