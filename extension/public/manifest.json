{
  "manifest_version": 3,
  "name": "Tabletidy: private table cleanup with hybrid AI",
  "short_name": "Tabletidy",
  "version": "0.2.0",
  "description": "Pick a table on any page. Gemini Nano names and types its columns on your device and flags personal data. Export clean CSV or JSON.",
  "minimum_chrome_version": "139",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Tabletidy", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"]
}
